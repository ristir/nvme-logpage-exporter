nvme_logpage_critical_warning_flag{device="nvme0",flag="temperature",serial="SYNTHETIC0000001"} 0
nvme_logpage_critical_warning_flag{device="nvme0",flag="volatile_backup_failed",serial="SYNTHETIC0000001"} 0
# HELP nvme_logpage_endurance_used_ratio Consumed write endurance as a fraction, 0..1. May exceed 1: the specification allows values above 100 percent.
# TYPE nvme_logpage_endurance_used_ratio gauge
nvme_logpage_endurance_used_ratio{device="nvme0",serial="SYNTHETIC0000001"} 0.02
